form TrainBooking {
  title "Train Ticket Booking"
  description "Enter passenger and journey details. This demo form does not check live schedules, fares, or seat availability and does not book a ticket."

  field passengerName: text {
    label "Passenger name"
    section "Passenger details"
    placeholder "Name as shown on your ID"
    required
  }

  field emailAddress: text {
    label "Email address"
    section "Passenger details"
    placeholder "you@example.com"
    required
  }

  field contactNumber: text {
    label "Contact number"
    section "Passenger details"
    placeholder "Include your country or area code"
    required
  }

  field origin: choice { mumbai, pune, delhi, chennai } {
    label "From"
    section "Journey details"
    placeholder "Choose a departure city"
    required
  }

  field destination: choice { mumbai, pune, delhi, chennai } {
    label "To"
    section "Journey details"
    placeholder "Choose a destination"
    required
  }

  field journeyDate: date {
    label "Date of journey"
    section "Journey details"
    required
  }

  field passengerCount: integer {
    label "Number of passengers"
    section "Journey details"
    placeholder "At least one passenger"
    required
  }

  field travelClass: choice { sleeper, third_ac, second_ac, first_ac } {
    label "Travel class"
    section "Journey details"
    placeholder "Choose a travel class"
    required
  }

  check passengerName != "" message "Enter the passenger name"
  check origin != destination message "Departure and destination must be different"
  check passengerCount >= 1 message "Enter at least one passenger"
}
