form EventRegistration {
  title "Event Registration"
  description "A starter form for an event registration. This demo does not reserve a ticket or submit data to an organizer."

  field attendeeName: text {
    label "Attendee name"
    section "Attendee details"
    placeholder "Enter your full name"
    required
  }

  field emailAddress: text {
    label "Email address"
    section "Attendee details"
    placeholder "you@example.com"
    required
  }

  field organization: text {
    label "School or organization"
    section "Attendee details"
    placeholder "Optional"
  }

  field participation: choice { in_person, virtual } {
    label "How will you attend?"
    section "Event preferences"
    placeholder "Choose an attendance option"
    required
  }

  field ticketType: choice { student, general, speaker } {
    label "Registration type"
    section "Event preferences"
    placeholder "Choose a registration type"
    required
  }

  field accessibilitySupport: boolean {
    label "I need accessibility support"
    section "Event preferences"
  }

  field supportDetails: text {
    label "What support would be helpful?"
    section "Event preferences"
    help "Share only the details needed to arrange support."
    placeholder "Describe your request"
    show when accessibilitySupport == true
    required when accessibilitySupport == true
  }

  check attendeeName != "" message "Enter the attendee name"
}
